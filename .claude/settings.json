{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__(push_files|create_or_update_file|delete_file|merge_pull_request|enable_pr_auto_merge)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__ha-testbench",
      "mcp__ha-raspi__ha_get_overview",
      "mcp__ha-raspi__ha_search",
      "mcp__ha-raspi__ha_get_state",
      "mcp__ha-raspi__ha_get_entity",
      "mcp__ha-raspi__ha_get_device",
      "mcp__ha-raspi__ha_get_integration",
      "mcp__ha-raspi__ha_get_history",
      "mcp__ha-raspi__ha_get_logs",
      "mcp__ha-raspi__ha_get_automation_traces",
      "mcp__ha-raspi__ha_eval_template",
      "mcp__ha-raspi__ha_get_skill_guide",
      "mcp__ha-raspi__ha_get_system_health",
      "mcp__ha-raspi__ha_get_operation_status",
      "mcp__ha-raspi__ha_list_services",
      "mcp__ha-raspi__ha_list_floors_areas",
      "mcp__ha-raspi__ha_get_zone",
      "mcp__ha-raspi__ha_config_get_automation",
      "mcp__ha-raspi__ha_config_get_script",
      "mcp__ha-raspi__ha_config_get_scene",
      "mcp__ha-raspi__ha_config_list_helpers",
      "mcp__ha-raspi__ha_config_set_automation",
      "mcp__ha-raspi__ha_config_set_script",
      "mcp__ha-raspi__ha_config_set_scene",
      "mcp__ha-raspi__ha_call_service",
      "mcp__ha-raspi__ha_call_event"
    ],
    "deny": [
      "Read(**/*.kdbx)",
      "Read(**/*.keyx)",
      "Read(**/.env)",
      "Read(**/*.env)"
    ]
  }
}
