# Keys of /etc/docker/smart-home/.env. The values come from KeePass: raspberry's secrets role
# (ansible/roles/secrets) renders the file on the Pi. `setup.sh local` copies a hand-made setup/.env instead.
IOBROKER_STATES_REDIS_PORT=
IOBROKER_OBJECTS_REDIS_PORT=

INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_READ_PASSWORD=
INFLUXDB_WRITE_PASSWORD=

GRAFANA_PASSWORD=

MOSQUITTO_PASSWD=

DECONZ_VNC_PASSWORD=
# DECONZ_DEVICE_TYPE=

GITHUB_USER=
GITHUB_EMAIL=
