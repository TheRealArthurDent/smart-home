      "pluginVersion": "11.1.4",
      "targets": [
        {
          "alias": "$0 | $1 | $2",
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB"
          },
          "query": "SELECT last(\"value\") AS value\nFROM /^(?:${deviceType:regex})\\.(?:${room:regex})\\.(?:${function:regex})(?:\\:[^.]*)?\\.reachable$/\nWHERE $timeFilter AND value = 0\nGROUP BY \"deviceType\", \"room\", \"function\"",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series"
        }
      ],
      "title": "Unreachable devices",
      "type": "stat"
