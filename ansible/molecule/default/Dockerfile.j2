# Approximates a fresh Raspberry Pi OS Lite (trixie) with the deploy user smarthome.
FROM {{ item.image }}

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 sudo ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash smarthome \
 && echo 'smarthome ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/bootstrap \
 && chmod 0440 /etc/sudoers.d/bootstrap
