# Copy to .env next to this file (git-ignored) and fill in. The tokens are the long-lived tokens of the user claude
# in each Home Assistant; keep them in KeePass, never in the repo.
HA_TESTBENCH_URL=
HA_TESTBENCH_TOKEN=
HA_RASPI_URL=
HA_RASPI_TOKEN=
# Absolute path of the private root CA (PEM) that signed Home Assistant's certificates
HA_CA_FILE=
