{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>TheRealArthurDent/renovate:homelab"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Home Assistant's MCP server for Claude Code: the image .mcp.json starts with docker run.",
      "managerFilePatterns": [
        "/^\\.mcp\\.json$/"
      ],
      "matchStrings": [
        "\"(?<depName>ghcr\\.io/homeassistant-ai/ha-mcp):(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Pin deconz stable versions.",
      "groupName": "deconz",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "deconzcommunity/deconz"
      ],
      "matchManagers": [
        "docker-compose"
      ],
      "versioning": "loose",
      "pinDigests": true,
      "rangeStrategy": "pin"
    },
    {
      "description": "IKEA firmware downloader: own image on its latest tag, pinned by digest. Merged by GitHub auto-merge once the required checks pass, without waiting for a release age.",
      "groupName": "ikea-firmware-downloader",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/therealarthurdent/ikea-firmware-downloader"
      ],
      "matchManagers": [
        "docker-compose"
      ],
      "versioning": "loose",
      "pinDigests": true,
      "rangeStrategy": "pin",
      "minimumReleaseAge": null,
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "addLabels": [
        "auto-merge"
      ]
    },
    {
      "description": "ansible-lint, molecule and molecule-plugins are usually released together; update them in one PR.",
      "groupName": "ansible-devtools",
      "matchPackageNames": [
        "ansible-lint",
        "molecule",
        "molecule-plugins"
      ]
    }
  ]
}
